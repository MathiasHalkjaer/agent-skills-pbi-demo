table FactSales
	lineageTag: 2499dfbc-a807-5d67-b65a-7afd6e23171b

	measure TotalSales = SUM(FactSales[sales_amt])
		lineageTag: c59a0f47-5911-54f2-8397-6aeeb54acd9c

	measure total_cost = SUM(FactSales[cost_amt])
		lineageTag: 2581a4ba-531f-5bae-bd19-0825fcf66611

	measure Margin = DIVIDE([TotalSales]-[total_cost],[TotalSales])
		lineageTag: 41db49e9-f9da-5b88-ae89-7df24e59c661

	measure NetSales = CALCULATE([TotalSales],FactSales[return_flag]=0)
		lineageTag: 639a238d-24de-5931-b8bd-dc6309e09411

	measure 'Sales LY' = CALCULATE([TotalSales],SAMEPERIODLASTYEAR(DimDate[date_key]))
		lineageTag: 7547b091-bb77-52ba-a727-8cd822c62dab

	measure 'Sales Status' = IF([TotalSales]>50000,"High",IF([TotalSales]>20000,"Medium","Low"))
		lineageTag: 047e9307-affe-541d-9873-d579afe8100d

